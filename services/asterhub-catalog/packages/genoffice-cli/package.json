    "compatibility": {
      "dsh": "0.1.6-alpha.2",
      "dshReleases": { "0.1.6-alpha.2": "compatible" },
      "profiles": ["web"]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-mcp-client": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-subprocess": "0.1.6-alpha.2",
    "@modelcontextprotocol/client": "2.0.0"
  }
}
