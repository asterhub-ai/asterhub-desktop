{
  "name": "@asterhub/genoffice-cli",
  "version": "0.11.0-asterhub.1",
  "private": true,
  "type": "module",
  "description": "Workspace-scoped GenOffice CLI tools for AsterHub",
  "license": "Apache-2.0",
  "main": "./index.mjs",
  "files": [
    "cordis.patch.yml",
    "index.mjs",
    "resources/**",
    "LICENSE",
    "NOTICE",
    "LICENSE-UNICODE.txt",
    "THIRD-PARTY-NOTICES.txt",
    "UPSTREAM.md"
  ],
  "dsh": {
