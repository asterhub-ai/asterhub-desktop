server {
    listen 443 ssl http2;
    server_name asterhub.xapi.fans;

    # Configure certificate paths from the host's existing certificate manager.
    # ssl_certificate     /path/to/fullchain.pem;
    # ssl_certificate_key /path/to/privkey.pem;

    client_max_body_size 1m;

    # Replace this with the public COS hostname for DOWNLOAD_PROD_COS_BUCKET.
    # This remains a read-only proxy; publication credentials stay in the release uploader.
    set $cos_host bucket.cos.region.myqcloud.com;
    resolver 1.1.1.1 1.0.0.1 valid=300s ipv6=off;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    proxy_ssl_verify on;
    proxy_ssl_verify_depth 3;

    location ^~ /dsh-desk/feeds/ {
        limit_except GET HEAD { deny all; }
        proxy_pass https://$cos_host$request_uri;
        proxy_ssl_server_name on;
        proxy_ssl_name $cos_host;
        proxy_set_header Host $cos_host;
        proxy_set_header Authorization "";
        proxy_set_header Proxy-Authorization "";
        proxy_set_header Cookie "";
        proxy_hide_header Cache-Control;
        proxy_hide_header Expires;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    location ^~ /dsh-desk/bin/ {
        limit_except GET HEAD { deny all; }
        proxy_pass https://$cos_host$request_uri;
        proxy_ssl_server_name on;
        proxy_ssl_name $cos_host;
        proxy_set_header Host $cos_host;
        proxy_set_header Authorization "";
        proxy_set_header Proxy-Authorization "";
        proxy_set_header Cookie "";
        proxy_hide_header Cache-Control;
        proxy_hide_header Expires;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location / {
        proxy_pass http://127.0.0.1:18081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 30s;
    }
}
