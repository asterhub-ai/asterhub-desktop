{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:anima:schema:runtime-identity:v1.0",
  "title": "RuntimeIdentity",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_id": { "const": "anima.runtime-identity/v1.0" },
    "installation_uid": { "type": "string", "minLength": 1 },
    "runtime_family": { "type": "string", "minLength": 1 },
    "adapter_version": { "type": "string", "minLength": 1 },
    "core_version": { "type": "string", "minLength": 1 },
    "profile_uid": { "type": "string", "minLength": 1 },
    "profile_identity_method": { "enum": ["source", "derived", "generated"] },
    "runtime_version": { "type": "string", "minLength": 1 },
    "profile_name": { "type": "string", "minLength": 1 },
    "extensions": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$": {}
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schema_id",
    "installation_uid",
    "runtime_family",
    "adapter_version",
    "core_version",
    "profile_uid",
    "profile_identity_method"
  ]
}
