{
  "name": "@deepseek-ai/anima-protocol",
  "version": "0.2.0-rc.3",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./schemas/*.json": {
      "types": "./lib/types/schemas/*.json",
      "default": "./lib/types/schemas/*.json"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/types/schemas/**/*.json"
  ],
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "json-canonicalize": "3.0.1",
    "vitest": "^4.1.8"
  }
}
