{
  "name": "@deepseek-ai/dsh-anima-memory",
  "description": "Built-in local evidence-backed Anima memory",
  "version": "0.2.0-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asterhub-ai/asterhub-desktop.git",
    "directory": "packages/context/anima-memory"
  },
  "type": "module",
  "scripts": {
    "prepare:desktop-runtime": "tsx scripts/prepare-runtime.ts"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
