{
  "name": "@deepseek-ai/dsh-session-format-v4-to-v5",
  "description": "Identity-preserving conversion and native admission from Session V4 to V5",
  "version": "0.2.0-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/session/session-format-v4-to-v5"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "sessionFormatMigration": {
      "migration": "sessionFormatV4ToV5",
      "to": 5,
      "from": 4,
      "export": ".",
      "targetHeaderValidator": "assertReleasedV5Header",
      "targetRestorer": "restoreReleasedV5Artifact",
      "targetCodec": "releasedV5SessionFormatCodec",
      "sourceCodec": "releasedV4SessionFormatCodec"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-session-format": "workspace:*",
    "@deepseek-ai/dsh-session-format-v3-to-v4": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-session-format": "workspace:*",
    "@deepseek-ai/dsh-session-format-v3-to-v4": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  }
}
